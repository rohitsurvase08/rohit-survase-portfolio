# Environment Variables Example
# Copy this file to .env.local for local development
# DO NOT commit .env.local or any file containing actual secrets

# Next.js Environment Variables
# NEXT_PUBLIC_ prefix makes variables accessible in the browser

# Example: Analytics (if you add analytics later)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Example: Contact Form API (if you add a backend contact form)
# CONTACT_FORM_API_KEY=your_api_key_here
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://your-api-endpoint.com

# Note: This portfolio currently uses no environment variables
# This file is provided for future extensibility
